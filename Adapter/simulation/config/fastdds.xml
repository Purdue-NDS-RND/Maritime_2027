<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>simulation_shm</transport_id>
      <type>SHM</type>
      <!-- 1280x720 RGB/depth payloads exceed the default 512 KiB segment.
           32 MiB per participant restored delivery in controlled trials. -->
      <segment_size>33554432</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>simulation_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="simulation_adapter" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>simulation_udp</transport_id>
        <transport_id>simulation_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
