<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- UDP works with root-owned ROS peers whose SHM ports are inaccessible
       to the host-user tools container. Keep built-in SHM disabled. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>monitor_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="monitor" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>monitor_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
