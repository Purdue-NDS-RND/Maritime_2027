Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 40
    Tree Height: 340
    Property Tree Widget:
      Expanded:
        - /Scene1
        - /Scene1/Status1
      Splitter Ratio: 0.8
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Plane: XY
    - Class: rviz_default_plugins/Axes
      Name: World origin
      Enabled: true
      Reference Frame: world
      Length: 1
      Radius: 0.03
    - Class: rviz_default_plugins/MarkerArray
      Name: Scene
      Enabled: true
      Topic:
        Value: /monitor/simulation/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Camera 0 RGB
      Enabled: true
      Topic:
        Value: /sensors/camera_0/color/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: Camera 0 depth (0-20 m)
      Enabled: false
      Normalize Range: false
      Min Value: 0
      Max Value: 20
      Topic:
        Value: /sensors/camera_0/depth/image_rect_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Odometry
      Name: FCU odometry (map)
      Enabled: false
      Keep: 50
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Topic:
        Value: /mavros/local_position/odom
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 22
      Focal Point:
        X: 5
        Y: 0
        Z: 0
      Pitch: 0.5
      Yaw: 0.8
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Top down
        Angle: 0
        Scale: 40
        X: 0
        Y: 0
Window Geometry:
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: ""
  Width: 1280
  Height: 800
