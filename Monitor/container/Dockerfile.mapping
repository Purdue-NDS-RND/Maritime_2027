# Optional simulation monitoring tools; truth and GUI dependencies stay out of
# the production autonomy image. Build via make -C autonomy mapping-build.
FROM maritime-autonomy:jazzy
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-matplotlib python3-tk xvfb xauth \
    && rm -rf /var/lib/apt/lists/*
ENV HOME=/tmp/live-mapping MPLCONFIGDIR=/tmp/matplotlib \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    FASTRTPS_DEFAULT_PROFILES_FILE=/etc/live-fastdds.xml
ENTRYPOINT ["bash", "-c", "source /etc/maritime_autonomy_setup.bash && exec python3 /opt/live/live_session.py \"$@\"", "--"]
