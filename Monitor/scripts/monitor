#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
usage() {
    cat <<'EOF'
Usage: Monitor/scripts/monitor build|shell|rviz|rviz-sim|gui|config [arguments...]

  build                 Build the tools image (extra arguments go to Compose build)
  shell [COMMAND ...]   Open a ROS-sourced Bash shell, or run a command
  rviz [ARG ...]        Open RViz2 with the neutral default view
  rviz-sim [ARG ...]    Open the simulation world, entities and camera view
  gui COMMAND [ARG ...] Run another GUI tool, e.g. rqt_graph
  config                Validate and print resolved Compose configuration

ROS_DOMAIN_ID=0                  Match the target ROS graph
USE_SIM_TIME=false               Set true for RViz against simulation or bag /clock
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET  Configure discovery reach
ROS_STATIC_PEERS=ip1;ip2          Optional remote peers
MONITOR_OVERLAY_DIR=/abs/install Optional compatible ROS workspace install tree
LIBGL_ALWAYS_SOFTWARE=1          Use software rendering if GPU rendering fails

Requires native Linux and Docker Compose. GUI modes additionally require a local
X11/XWayland display and xauth. Shell mode does not require display access.
All sessions are disposable; /logs persists in Monitor/logs on the host.
EOF
}

action=${1:---help}
[[ $# == 0 ]] || shift
case "$action" in
    -h|--help|help) usage; exit 0 ;;
    build|shell|rviz|rviz-sim|gui|config) ;;
    *) usage >&2; exit 2 ;;
esac
if [[ $action == gui && $# == 0 ]]; then
    echo 'ERROR: gui requires a command, e.g. gui rqt_graph' >&2
    exit 2
fi
if [[ $(uname -s) != Linux ]]; then
    echo 'ERROR: native Linux is required for host networking.' >&2
    exit 1
fi
export HOST_UID=$(id -u) HOST_GID=$(id -g)
export VIDEO_GID RENDER_GID
VIDEO_GID=$(getent group video | cut -d: -f3 || true)
RENDER_GID=$(getent group render | cut -d: -f3 || true)
VIDEO_GID=${VIDEO_GID:-$HOST_GID}
RENDER_GID=${RENDER_GID:-$HOST_GID}
compose=(docker compose -f "$PROJECT_DIR/container/compose.yaml")
if [[ -d /dev/dri && ${LIBGL_ALWAYS_SOFTWARE:-0} != 1 ]]; then
    compose+=(-f "$PROJECT_DIR/container/compose.gpu.yaml")
fi
case "$action" in
    config) exec "${compose[@]}" config "$@" ;;
    build) exec "${compose[@]}" build "$@" shell ;;
esac

mkdir -p "$PROJECT_DIR/logs"
if ! docker image inspect "${MONITOR_IMAGE:-maritime-monitor:jazzy}" >/dev/null 2>&1; then
    "${compose[@]}" build shell
fi
run_options=(--rm --no-deps)
if [[ ! -t 0 || ! -t 1 ]]; then
    run_options+=(-T)
fi
if [[ $action == shell ]]; then
    exec "${compose[@]}" run "${run_options[@]}" shell "$@"
fi

if [[ -z ${DISPLAY:-} ]] || ! command -v xauth >/dev/null 2>&1; then
    echo 'ERROR: GUI mode requires DISPLAY and host xauth; shell works without them.' >&2
    exit 1
fi
cookie=$(xauth nlist "$DISPLAY" 2>/dev/null || true)
if [[ -z $cookie ]]; then
    echo 'ERROR: no X11 authorization cookie for DISPLAY; check host XAUTHORITY.' >&2
    exit 1
fi
MONITOR_XAUTH_FILE=$(mktemp /tmp/maritime-monitor-xauth.XXXXXX)
export MONITOR_XAUTH_FILE
trap 'rm -f -- "$MONITOR_XAUTH_FILE"' EXIT
printf '%s\n' "$cookie" | sed 's/^..../ffff/' | xauth -f "$MONITOR_XAUTH_FILE" nmerge -
chmod 600 "$MONITOR_XAUTH_FILE"
if [[ $action == rviz || $action == rviz-sim ]]; then
    rviz_command=rviz2
    preset=default
    if [[ $action == rviz-sim ]]; then
        rviz_command=/opt/monitor/tools/rviz-simulation
        preset=simulation
    fi
    run_options+=(-v "$PROJECT_DIR/config/rviz/$preset.rviz:/opt/monitor/config/rviz/$preset.rviz:ro")
    view_args=(-d "/opt/monitor/config/rviz/$preset.rviz")
    for argument in "$@"; do
        case "$argument" in
            -d|--display-config|--display-config=*) view_args=(); break ;;
        esac
    done
    "${compose[@]}" run "${run_options[@]}" gui "$rviz_command" \
        "${view_args[@]}" "$@" \
        --ros-args -p "use_sim_time:=${USE_SIM_TIME:-false}"
else
    "${compose[@]}" run "${run_options[@]}" gui "$@"
fi
