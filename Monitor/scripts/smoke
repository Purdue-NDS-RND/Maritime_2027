#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export ROS_DOMAIN_ID=${MONITOR_TEST_DOMAIN_ID:-97}
export ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET ROS_STATIC_PEERS=''
export HOST_UID=$(id -u) HOST_GID=$(id -g)
mkdir -p "$PROJECT_DIR/logs"
compose=(docker compose -f "$PROJECT_DIR/container/compose.yaml")
publisher="maritime-monitor-probe-pub-$$"
subscriber="maritime-monitor-probe-sub-$$"
cleanup() {
    docker stop --time 3 "$publisher" "$subscriber" >/dev/null 2>&1 || true
    docker rm -f "$publisher" "$subscriber" >/dev/null 2>&1 || true
}
trap cleanup EXIT
docker run --rm --init --network host --ipc host -d --name "$publisher" \
    --user "${MONITOR_TEST_PUBLISHER_USER:-0:0}" \
    -e ROS_DOMAIN_ID -e ROS_AUTOMATIC_DISCOVERY_RANGE -e ROS_STATIC_PEERS \
    -e FASTRTPS_DEFAULT_PROFILES_FILE=/tests/peer-fastdds.xml \
    -v "$PROJECT_DIR/tests:/tests:ro" "${MONITOR_IMAGE:-maritime-monitor:jazzy}" \
    python3 /tests/message_probe.py publish >/dev/null
"${compose[@]}" run --rm --no-deps -T --name "$subscriber" \
    -v "$PROJECT_DIR/tests:/tests:ro" shell python3 /tests/message_probe.py subscribe
"${compose[@]}" run --rm --no-deps -T --name "$subscriber" shell \
    bash --rcfile /etc/monitor.bashrc -ic \
    'timeout 15 ros2 topic echo /monitor_smoke/buoys --once --field session_id | grep -Fx monitor-smoke'
echo 'PASS: Monitor shell ros2 topic echo deserializes BuoyMap'
"${compose[@]}" run --rm --no-deps -T --name "$subscriber" shell \
    bash --rcfile /etc/monitor.bashrc -ic \
    'output=$(PYTHONUNBUFFERED=1 timeout 8 ros2 topic hz /monitor_smoke/buoys --window 10 2>&1)
     status=$?
     printf "%s\n" "$output"
     [[ $status == 124 ]] && grep -q "average rate:" <<< "$output"'
echo 'PASS: Monitor shell ros2 topic hz measures BuoyMap delivery'
