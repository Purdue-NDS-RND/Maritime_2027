#!/usr/bin/env bash
set -euo pipefail
python3 /opt/monitor/tools/simulation_view.py &
helper_pid=$!
rviz_pid=
cleanup() {
    kill "$helper_pid" ${rviz_pid:+"$rviz_pid"} 2>/dev/null || true
    wait "$helper_pid" ${rviz_pid:+"$rviz_pid"} 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
rviz2 "$@" --ros-args -p use_sim_time:=true \
    -r /tf:=/monitor/simulation/tf -r /tf_static:=/monitor/simulation/tf_static &
rviz_pid=$!
wait -n "$helper_pid" "$rviz_pid"
