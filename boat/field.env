# Hardware settings. Edit for this computer; `make field` loads this file.
# Paths are relative to container/compose.yaml, except COMPOSE_FILE (from boat/).
COMPOSE_FILE=container/compose.yaml:container/compose.serial.yaml
BOAT_CONNECTION=/dev/boat-fcu
# Select one recognized USB controller automatically; make scan lists candidates.
# Set an explicit path when multiple controllers are attached or using a UART.
BOAT_SERIAL_DEVICE=auto
# Derive the selected device's numeric group, or set an explicit group ID.
BOAT_SERIAL_GID=auto
# Match the actual Pixhawk connection's baud rate.
BOAT_BAUD=115200
# Listen on all IPv4 interfaces, including Wi-Fi and Tailscale when configured.
# The GCS connects using the Jetson's actual Wi-Fi or Tailscale IP, not 0.0.0.0.
BOAT_HTTP_HOST=0.0.0.0
BOAT_HTTP_PORT=8091
BOAT_ROS_DOMAIN_ID=27
# Physical mission.json for make upload; GCS upload does not need a local file.
# May be replaced with an absolute directory. Never use the simulator example.
MISSION_DIR=../../simulation/logs/boat/field-missions
