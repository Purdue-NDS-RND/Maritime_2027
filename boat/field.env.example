# Jetson. Copy to field.env and replace the example address/device/GID.
# Bind to the Jetson's Wi-Fi/Ethernet IPv4 address on the private control LAN.
BOAT_HTTP_HOST=192.168.50.2
BOAT_HTTP_PORT=8091
BOAT_SERIAL_DEVICE=/dev/serial/by-id/REPLACE_WITH_PIXHAWK
# Find the numeric group with: stat -Lc %g /dev/serial/by-id/YOUR_DEVICE
BOAT_SERIAL_GID=20
BOAT_BAUD=115200
