ARG GCS_TEST_BASE=maritime-gcs:latest
FROM ${GCS_TEST_BASE}
COPY gcs/requirements-test.txt /tmp/requirements-test.txt
RUN pip install --no-cache-dir -r /tmp/requirements-test.txt
COPY gcs/tests /app/gcs/tests
COPY gcs/app /app/gcs/app
COPY shared /app/shared
ENV PYTHONPATH=/app
CMD ["python3", "-m", "unittest", "discover", "-s", "/app/gcs/tests", "-v"]
