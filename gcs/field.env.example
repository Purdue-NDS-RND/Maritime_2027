# Shore computer. Copy to field.env and replace the example address/device/GID.
GCS_BOAT_URL=http://192.168.50.2:8091
GCS_SERIAL_DEVICE=/dev/serial/by-id/REPLACE_WITH_SHORE_RFD
# Find the numeric group with: stat -Lc %g /dev/serial/by-id/YOUR_DEVICE
GCS_SERIAL_GID=20
# Match the configured radio host baud and the intended Pixhawk IDs.
GCS_MAVLINK_BAUD=57600
GCS_MAVLINK_SYSTEM_ID=1
GCS_MAVLINK_COMPONENT_ID=1
