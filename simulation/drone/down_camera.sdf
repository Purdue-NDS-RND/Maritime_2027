<sensor name="down_camera" type="camera">
  <!-- Gazebo cameras look along local +X. +90 degrees pitch turns +X toward -Z. -->
  <pose degrees="true">0 0 -0.11 0 90 0</pose>
  <always_on>true</always_on>
  <update_rate>15</update_rate>
  <topic>/iris/down_camera/image</topic>
  <camera>
    <camera_info_topic>/iris/down_camera/camera_info</camera_info_topic>
    <horizontal_fov>1.5707963267948966</horizontal_fov>
    <image><width>1280</width><height>960</height><format>R8G8B8</format></image>
    <clip><near>0.02</near><far>120</far></clip>
  </camera>
</sensor>
