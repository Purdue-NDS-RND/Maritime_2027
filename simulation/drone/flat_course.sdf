<?xml version="1.0"?>
<sdf version="1.9">
  <world name="iris_competition">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor>
    </physics>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>51.566151</latitude_deg>
      <longitude_deg>-4.034345</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>0.85 0.85 0.85 1</ambient><background>0.65 0.78 0.92 1</background></scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows><diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground">
        <collision name="floor_collision">
          <geometry><plane><normal>0 0 1</normal><size>250 250</size></plane></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><plane><normal>0 0 1</normal><size>250 250</size></plane></geometry>
          <material><ambient>0.34 0.36 0.38 1</ambient><diffuse>0.34 0.36 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include>
      <name>iris</name>
      <uri>model://iris_with_ardupilot</uri>
      <pose degrees="true">0 0 0.195 0 0 90</pose>
    </include>
  </world>
</sdf>
